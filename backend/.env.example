# Copy to backend/.env. Credentials are read only by FastAPI.
# The provider must support image_url input and strict json_schema output
# on an OpenAI-compatible /chat/completions endpoint.
VISION_API_KEY=
VISION_MODEL=
VISION_BASE_URL=https://api.openai.com/v1
VISION_TIMEOUT_SECONDS=60
FRONTEND_ORIGIN=http://localhost:3000

# Explicit offline demo: only the two exact public/samples images are accepted.
# No model is called, and every successful response says source="fixture".
SIDEKICK_FIXTURE_MODE=false

# Local prototype persistence. Run `npm run db:migrate` once before startup.
DATABASE_URL=sqlite:///backend/data/sidekick.db
APP_ENV=development
# Only development/test may select dev. Production always defaults to strict.
PASSWORD_POLICY=dev
# TODO: Turn on strict password rules before pilot.
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://localhost:3000

# Private, retained homework originals/pages. Blank uses the database sibling uploads/.
# A custom directory must stay outside public assets and source control.
SIDEKICK_PRIVATE_UPLOAD_DIR=
SIDEKICK_MAX_UPLOAD_MB=10
SIDEKICK_MAX_PDF_PAGES=6
SIDEKICK_MAX_PAGE_PIXELS=24000000
SIDEKICK_MAX_TOTAL_PIXELS=72000000
SIDEKICK_PDF_TIMEOUT_SECONDS=20
SIDEKICK_PDF_MEMORY_MB=1024
# Mask top 6% before provider calls; 0 disables, maximum 0.2.
# This does not remove names elsewhere in images and may hide worksheet text.
SIDEKICK_HEADER_REDACTION_FRACTION=0.06

# Learning thresholds/timezone are versioned in backend/gap/config.json.
# The shared model adapter uses VISION_* above; no additional AI key is needed.
