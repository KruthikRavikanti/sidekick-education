{
  "name": "sidekick-education",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:demo": "node scripts/dev.mjs --fixtures",
    "dev:all": "node scripts/dev.mjs",
    "db:migrate": "backend/.venv/bin/python -m backend.accounts migrate",
    "db:seed": "backend/.venv/bin/python -m backend.accounts seed",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:backend": "backend/.venv/bin/python -m pytest backend/tests -q"
  },
  "dependencies": {
    "lucide-react": "1.70.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
