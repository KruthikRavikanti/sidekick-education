{
  "name": "sidekick-education",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:demo": "node scripts/dev.mjs --fixtures",
    "dev:all": "node scripts/dev.mjs",
    "db:migrate": "backend/.venv/bin/python -m backend.accounts migrate",
    "db:seed": "backend/.venv/bin/python -m backend.accounts seed",
    "catalog:seed": "backend/.venv/bin/python -m backend.gap seed-catalog",
    "activities:seed": "backend/.venv/bin/python -m backend.activities seed-library",
    "activities:coverage": "backend/.venv/bin/python scripts/build_activity_coverage.py --report-only",
    "activities:coverage:check": "backend/.venv/bin/python scripts/build_activity_coverage.py --check --report-only",
    "activities:verify:catalog:live": "backend/.venv/bin/python scripts/verify_catalog_activities.py --live",
    "activities:verify:composition:live": "backend/.venv/bin/python scripts/verify_composed_activities.py --live",
    "activities:verify:live": "backend/.venv/bin/python scripts/verify_composed_activities.py --live",
    "activities:verify:general:live": "backend/.venv/bin/python scripts/verify_composed_activities.py --live",
    "activities:verify:equivalent:live": "backend/.venv/bin/python scripts/verify_equivalent_activity.py --live",
    "activities:verify:toolkit:live": "backend/.venv/bin/python scripts/verify_composed_activities.py --live",
    "games:seed": "backend/.venv/bin/python -m backend.games seed",
    "games:robot": "backend/.venv/bin/python -m backend.games robot",
    "games:generate": "backend/.venv/bin/python -m backend.games generate",
    "games:list": "backend/.venv/bin/python -m backend.games list",
    "games:verify": "backend/.venv/bin/python -m backend.games verify",
    "games:coverage": "backend/.venv/bin/python -m backend.games coverage",
    "gap:evaluate": "backend/.venv/bin/python -m backend.gap.evaluation",
    "gap:evaluate:live": "backend/.venv/bin/python -m backend.gap.evaluation --live",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:backend": "backend/.venv/bin/python -m pytest backend/tests -q"
  },
  "dependencies": {
    "lucide-react": "1.70.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
