  "actions": [
    {
      "id": "inspect",
      "componentId": "map-controls",
      "operation": "inspect_location",
      "inputs": [
        {
          "id": "location",
          "kind": "choice",
          "minimum": null,
          "maximum": null,
          "minLength": null,
          "maxLength": null,
          "options": [
            "seed-station",
            "publisher"
          ],
          "maxItems": null,
