      "onAction": "travel",
      "when": {
        "kind": "always"
      },
      "effects": [
        {
          "kind": "set",
          "target": "traveler-location",
          "value": {
            "kind": "input",
            "ref": "destination"
          }
        }
      ]
    }
  ],
