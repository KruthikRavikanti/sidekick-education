  "world": {
    "state": [
      {
        "id": "traveler-location",
        "mutable": true,
        "kind": "choice",
        "initial": "seed-station",
        "options": [
          "seed-station",
          "publisher"
        ]
      },
      {
        "id": "discoveries",
        "mutable": true,
        "kind": "id_set",
        "initial": [],
        "options": [
          "seed-station",
          "publisher"
        ],
        "maxItems": 2
      },
      {
        "id": "chosen-detail",
        "mutable": true,
        "kind": "choice",
        "initial": "none",
        "options": [
          "none",
          "breeze",
          "burrs"
        ]
      },
      {
        "id": "report-text",
        "mutable": true,
        "kind": "text",
        "initial": "",
        "maxLength": 4000
      }
    ],
    "materials": [
      {
        "id": "seed-passage",
        "kind": "passage",
        "text": "Seeds can reach new places in different ways. A breeze blows dandelion seeds across a field. Burrs stick to a fox's coat and travel with it.",
        "items": [
          {
            "id": "breeze",
            "text": "A breeze blows dandelion seeds across a field."
          },
          {
            "id": "burrs",
            "text": "Burrs stick to a fox's coat and travel with it."
          }
        ],
        "quantity": null
      },
      {
        "id": "detail-prompt",
        "kind": "prompt",
        "text": "Read the whole report. Choose one detail to display beneath your main-idea label.",
        "items": [],
        "quantity": null
      },
      {
        "id": "label-prompt",
        "kind": "prompt",
        "text": "Write a label in your own words telling what the whole report is mostly about. You can change your label or detail before visiting the publisher.",
        "items": [],
        "quantity": null
      }
    ],
