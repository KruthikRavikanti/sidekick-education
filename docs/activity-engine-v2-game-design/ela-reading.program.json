          "id": "destination",
          "kind": "choice",
          "minimum": null,
          "maximum": null,
          "minLength": null,
          "maxLength": null,
          "options": [
            "seed-station",
            "publisher"
          ],
          "maxItems": null,
          "mediaKind": null
        }
      ],
      "label": "Travel"
    }
  ],
  "rules": [
    {
      "id": "inspect-place",
      "onAction": "inspect",
      "when": {
        "kind": "all",
        "conditions": [
          {
            "kind": "compare",
            "op": "eq",
            "left": {
              "kind": "input",
              "ref": "location"
            },
            "right": {
              "kind": "state",
              "ref": "traveler-location"
            }
          },
          {
            "kind": "any",
            "conditions": [
              {
                "kind": "compare",
                "op": "eq",
                "left": {
                  "kind": "input",
                  "ref": "location"
                },
                "right": {
                  "kind": "literal",
                  "value": "seed-station"
                }
              },
              {
                "kind": "all",
                "conditions": [
                  {
                    "kind": "compare",
                    "op": "eq",
                    "left": {
                      "kind": "input",
                      "ref": "location"
                    },
                    "right": {
                      "kind": "literal",
                      "value": "publisher"
                    }
                  },
                  {
                    "kind": "compare",
                    "op": "ne",
                    "left": {
                      "kind": "state",
                      "ref": "chosen-detail"
                    },
                    "right": {
                      "kind": "literal",
                      "value": "none"
                    }
                  },
                  {
                    "kind": "compare",
                    "op": "ne",
                    "left": {
                      "kind": "state",
                      "ref": "report-text"
                    },
                    "right": {
                      "kind": "literal",
                      "value": ""
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "effects": [
        {
          "kind": "add_item",
          "target": "discoveries",
          "item": {
            "kind": "input",
            "ref": "location"
          }
        }
      ]
    },
    {
      "id": "display-detail",
      "onAction": "choose-detail",
      "when": {
        "kind": "all",
        "conditions": [
          {
            "kind": "contains",
            "collection": {
              "kind": "state",
              "ref": "discoveries"
            },
            "item": {
              "kind": "literal",
              "value": "seed-station"
            }
          },
          {
            "kind": "compare",
            "op": "eq",
            "left": {
              "kind": "state",
              "ref": "traveler-location"
            },
            "right": {
              "kind": "literal",
              "value": "seed-station"
            }
          }
        ]
      },
      "effects": [
        {
          "kind": "set",
          "target": "chosen-detail",
          "value": {
            "kind": "input",
            "ref": "sentence"
          }
        }
      ]
    },
    {
      "id": "save-draft",
      "onAction": "write-label",
      "when": {
        "kind": "all",
        "conditions": [
          {
            "kind": "contains",
            "collection": {
              "kind": "state",
              "ref": "discoveries"
            },
            "item": {
              "kind": "literal",
              "value": "seed-station"
            }
          },
          {
            "kind": "compare",
            "op": "eq",
            "left": {
              "kind": "state",
              "ref": "traveler-location"
            },
            "right": {
              "kind": "literal",
              "value": "seed-station"
            }
          }
        ]
      },
      "effects": [
        {
          "kind": "set",
          "target": "report-text",
          "value": {
            "kind": "input",
            "ref": "text"
          }
        }
      ]
    },
    {
      "id": "change-draft",
      "onAction": "revise-label",
      "when": {
        "kind": "all",
        "conditions": [
          {
            "kind": "contains",
            "collection": {
              "kind": "state",
              "ref": "discoveries"
            },
            "item": {
              "kind": "literal",
              "value": "seed-station"
            }
          },
          {
            "kind": "compare",
            "op": "eq",
            "left": {
              "kind": "state",
              "ref": "traveler-location"
            },
            "right": {
              "kind": "literal",
              "value": "seed-station"
            }
          },
          {
            "kind": "compare",
            "op": "ne",
            "left": {
              "kind": "state",
              "ref": "report-text"
            },
            "right": {
              "kind": "literal",
              "value": ""
            }
          },
          {
            "kind": "compare",
            "op": "ne",
            "left": {
              "kind": "input",
              "ref": "text"
            },
            "right": {
              "kind": "state",
              "ref": "report-text"
            }
          }
        ]
      },
      "effects": [
        {
          "kind": "set",
          "target": "report-text",
          "value": {
            "kind": "input",
            "ref": "text"
          }
        }
      ]
    },
    {
