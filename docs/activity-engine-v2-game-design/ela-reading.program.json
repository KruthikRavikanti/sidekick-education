        "materialIds": [],
        "width": null,
        "height": null
      },
      {
        "id": "detail-board",
        "kind": "evidence_board",
        "bindings": {
          "selection": "chosen-detail"
        },
        "materialIds": [
          "seed-passage",
          "detail-prompt"
