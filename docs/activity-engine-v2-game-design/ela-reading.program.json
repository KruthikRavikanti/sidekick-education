          "kind": "choice",
          "minimum": null,
          "maximum": null,
          "minLength": null,
          "maxLength": null,
          "options": [
            "breeze",
            "burrs"
          ],
          "maxItems": null,
          "mediaKind": null
        }
      ],
      "label": "Display a detail"
