      "assessment": {
        "kind": "parent_review",
        "rubric": [
          "Check whether the child's label identifies the main idea of the complete passage: seeds reach new places in different ways.",
          "The label should cover both wind and animal transport, rather than only the selected detail.",
          "Check that the selected literal sentence supports the label. A saved label or selected detail alone does not establish a correct main idea."
        ]
      },
      "assistance": "server_event_history"
    }
