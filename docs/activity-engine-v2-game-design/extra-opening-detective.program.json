        "kind": "all",
        "conditions": [
          {
            "kind": "compare",
            "op": "eq",
            "left": {
              "kind": "state",
              "ref": "detective-location"
            },
            "right": {
              "kind": "literal",
              "value": "desk"
            }
          },
          {
            "kind": "compare",
            "op": "ne",
            "left": {
              "kind": "state",
              "ref": "draft"
            },
            "right": {
              "kind": "literal",
              "value": ""
            }
          },
          {
            "kind": "compare",
            "op": "ne",
            "left": {
              "kind": "input",
              "ref": "text"
            },
            "right": {
              "kind": "state",
              "ref": "draft"
            }
          },
          {
            "kind": "compare",
            "op": "ne",
            "left": {
              "kind": "input",
              "ref": "text"
            },
            "right": {
              "kind": "literal",
              "value": ""
            }
          }
        ]
      },
      "effects": [
        {
          "kind": "set",
          "target": "draft",
          "value": {
            "kind": "input",
            "ref": "text"
          }
        },
        {
          "kind": "set",
          "target": "revised",
          "value": {
            "kind": "literal",
            "value": true
          }
        }
