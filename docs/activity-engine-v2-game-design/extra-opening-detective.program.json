  "rules": [
    {
      "id": "inspect-at-table",
      "onAction": "investigate-source",
      "when": {
        "kind": "compare",
        "op": "eq",
        "left": {
          "kind": "state",
          "ref": "detective-location"
        },
        "right": {
          "kind": "literal",
          "value": "source"
        }
      },
      "effects": [
        {
          "kind": "add_item",
          "target": "discoveries",
          "item": {
            "kind": "input",
            "ref": "location"
          }
        }
      ]
    },
    {
      "id": "select-at-table",
      "onAction": "choose-clue",
      "when": {
        "kind": "all",
        "conditions": [
          {
            "kind": "compare",
            "op": "eq",
            "left": {
              "kind": "state",
              "ref": "detective-location"
            },
            "right": {
              "kind": "literal",
              "value": "source"
            }
          },
          {
            "kind": "contains",
            "collection": {
              "kind": "state",
              "ref": "discoveries"
            },
            "item": {
              "kind": "literal",
              "value": "source"
            }
          }
        ]
      },
      "effects": [
        {
          "kind": "set",
          "target": "chosen-clue",
          "value": {
            "kind": "input",
            "ref": "sentence"
          }
        }
      ]
    },
    {
      "id": "move-detective",
