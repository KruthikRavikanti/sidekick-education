        {
          "kind": "set",
          "target": "detective-location",
          "value": {
            "kind": "input",
            "ref": "destination"
          }
        }
      ]
    },
    {
      "id": "write-at-desk",
      "onAction": "write-opening",
      "when": {
        "kind": "all",
        "conditions": [
          {
            "kind": "compare",
            "op": "eq",
            "left": {
              "kind": "state",
              "ref": "detective-location"
            },
            "right": {
              "kind": "literal",
              "value": "desk"
            }
          },
          {
            "kind": "compare",
            "op": "ne",
            "left": {
              "kind": "state",
              "ref": "chosen-clue"
            },
            "right": {
              "kind": "literal",
              "value": "none"
            }
          },
          {
            "kind": "compare",
            "op": "eq",
            "left": {
              "kind": "state",
              "ref": "revised"
            },
            "right": {
              "kind": "literal",
              "value": false
            }
          }
        ]
      },
      "effects": [
        {
          "kind": "set",
          "target": "draft",
          "value": {
            "kind": "input",
            "ref": "text"
          }
        }
      ]
    },
    {
      "id": "revise-at-desk",
      "onAction": "revise-opening",
